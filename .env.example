# Optional local provider settings. Never commit real keys.
NYX_PROVIDER=mock
NYX_MODEL=local
NYX_WORKSPACE_ROOT=.
# Set to autonomous to skip interactive approval prompts for in-workspace mutations.
# Hard denials (outside-scope paths, unsafe URLs, and blocked destructive shell patterns) remain active.
NYX_AUTONOMY_MODE=manual
NYX_WHISPER_MODEL=base
NYX_WHISPER_LANGUAGE=tr
# Experimental Turkish adaptation; replace with a verified production Turkish checkpoint when available.
NYX_QWEN_TTS_BASE_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# Set this to the downloaded Turkish LoRA adapter directory.
NYX_QWEN_TTS_ADAPTER_DIR=
NYX_QWEN_TTS_LANGUAGE=Turkish
NYX_QWEN_TTS_DEVICE=auto

# Optional REST adapters; keep credentials local and never commit them.
NYX_CALENDAR_URL=
NYX_CALENDAR_TOKEN=
NYX_CRM_URL=
NYX_CRM_TOKEN=
NYX_WORDPRESS_URL=
NYX_WORDPRESS_TOKEN=
NYX_RESEARCH_URL=
NYX_RESEARCH_TOKEN=
